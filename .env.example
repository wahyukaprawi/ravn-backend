APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

NOTIFICATION_PUSH_DRIVER=log
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_BACKOFF_BASE_SECONDS=30
NOTIFICATION_BACKOFF_MAX_SECONDS=300
NOTIFICATION_BACKOFF_JITTER_SECONDS=10
NOTIFICATION_RECOVERY_MINUTES=15
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_ENDPOINT=https://fcm.googleapis.com/v1
FCM_TOKEN_URI=https://oauth2.googleapis.com/token

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REPORT_EXPORT_TTL_HOURS=24
REPORT_DEFAULT_RANGE_DAYS=30
REPORT_MAX_RANGE_DAYS=366
REPORT_MAX_ROWS=10000

EMPLOYEE_IMPORT_MAX_ROWS=5000
EMPLOYEE_IMPORT_MAX_KB=2048
GEOFENCE_RADIUS_MIN_METERS=1
GEOFENCE_RADIUS_MAX_METERS=50000
ATTENDANCE_MAX_ACCURACY_METERS=100
ATTENDANCE_GEOFENCE_ACCURACY_TOLERANCE_METERS=20
ATTENDANCE_FACE_CHALLENGE_TTL_MINUTES=5
ATTENDANCE_FACE_MAX_ATTEMPTS=3
